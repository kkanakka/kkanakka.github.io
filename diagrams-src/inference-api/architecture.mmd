%% section: Design
%% caption: Architecture — sync outside, async inside
flowchart LR
    CL("<b>Client</b><br/><span style='font-size:12px;color:#555'>POST /v1/inference<br/>blocks and waits</span>")
    GW("<b>Gateway</b> (stateless)<br/><span style='font-size:12px;color:#555'>auth · tier · capacity-aware limit<br/>stamps gateway_id<br/>pending: request_id → socket<br/>timeout 2s → 504</span>")
    RD("<b>Redis</b><br/><span style='font-family:Menlo,monospace;font-size:11.5px;color:#333'>LPUSH queue:{tier}<br/>RPOPLPUSH → inflight:{tier}<br/>LPUSH batch_queue<br/>LLEN → 429 decision</span>")
    BT("<b>Batcher</b><br/><span style='font-size:12px;color:#555'>drain 60/30/10<br/>send at 32 full or 40ms<br/>timeout shrinks with depth</span>")
    GPU("<b>GPU workers</b><br/><span style='font-size:12px;color:#555'>BLPOP batch_queue<br/>run batch ~50ms<br/>heartbeat → healthy count</span>")
    PS("<b>Redis pub/sub</b><br/><span style='font-family:Menlo,monospace;font-size:11.5px;color:#333'>PUBLISH responses:{gw_id}<br/>fire-and-forget</span>")
    PG("<b>Postgres</b><br/><span style='font-family:Menlo,monospace;font-size:11.5px;color:#333'>request row: status, latency<br/>audit + billing</span>")

    CL -->|"1 request"| GW
    GW -->|"2 LPUSH queue:{tier}"| RD
    BT -->|"3 RPOPLPUSH (crash-safe)"| RD
    BT -->|"4 LPUSH batch"| RD
    GPU -->|"5 BLPOP (blocks)"| RD
    GPU -->|"6 PUBLISH per request"| PS
    PS -.->|"7 only owning gateway"| GW
    GW -.->|"8 write held socket"| CL
    GPU -.->|"heartbeat"| GW
    GW -.->|"async audit"| PG
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class CL,GW,RD,BT,GPU,PS,PG n;
    linkStyle 0,1,2,3,4,5 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 6,7,8,9 stroke:#c2410c,stroke-width:1.6px;
