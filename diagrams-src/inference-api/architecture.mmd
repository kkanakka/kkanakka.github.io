    class CL,GW,Q,BT,GPU,PS,PGDB n;
    linkStyle 0,1,2,3,4,5,7 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 6,8,9,10 stroke:#7a2f6d,stroke-width:1.6px;
