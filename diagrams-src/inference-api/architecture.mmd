%% section: Design
%% caption: Architecture — sync outside, async inside
flowchart TB
    CL["<b>Client</b><br/>POST /v1/inference<br/>blocks and waits"]
    GW["<b>Gateway</b> (stateless)<br/>auth · tier · capacity-aware limit<br/>stamps gateway_id<br/>pending map: request_id → socket<br/>timeout 2s → 504"]
    Q[("<b>Redis</b> — queues<br/>LPUSH queue:{tier}<br/>RPOPLPUSH → inflight:{tier}:{b}<br/>LPUSH batch_queue<br/>LLEN = depth → 429 decision")]
    BT["<b>Batcher</b><br/>drain ent → paid → free (60/30/10)<br/>send at 32 full or 40ms<br/>timeout shrinks as depth grows"]
    GPU["<b>GPU workers</b><br/>BLPOP batch_queue (atomic claim)<br/>run batch ~50ms<br/>heartbeat → healthy_gpu_count"]
    PS[("<b>Redis pub/sub</b><br/>PUBLISH responses:{gateway_id}<br/>fire-and-forget")]
    PGDB[("<b>Postgres</b><br/>request row: status, latency<br/>audit + billing, async")]

    CL -->|"1 request"| GW
    GW -->|"2 LPUSH queue:{tier}"| Q
    BT -->|"3 RPOPLPUSH (crash-safe claim)"| Q
    BT -->|"4 LPUSH batch"| Q
    GPU -->|"5 BLPOP (blocks, no polling)"| Q
    GPU -->|"6 PUBLISH per request"| PS
    PS -.->|"7 only the owning gateway subscribes"| GW
    GW -->|"8 write the held socket"| CL
    GPU -.->|"heartbeat"| GW
    BT -.->|"trim inflight on ack"| Q
    GW -.->|"async audit"| PGDB
