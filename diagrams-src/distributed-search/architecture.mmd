%% section: Design
%% caption: Architecture — scatter-gather, tail control, optional rerank
flowchart TB
    CL["<b>Client</b><br/>q, k=20, filters, cursor"]
    QC["<b>Query coordinator</b><br/>parse · rewrite · plan once<br/>reject pathological shapes<br/>absolute deadline set here<br/>caps pagination depth"]
    SH1["<b>Shard 1</b> · 3 replicas<br/>~30 GB in memory<br/>skip-list postings<br/>ACL filter during match"]
    SH2["<b>Shard 2</b> · 3 replicas<br/>local top-k heap<br/>early termination"]
    SHN["<b>Shard 100</b> · 3 replicas<br/>returns k, not all matches"]
    MG["<b>Merge</b><br/>100 sorted lists → global top-k<br/>global IDF so scores compare<br/>partial flag + coverage"]
    LLM["<b>LLM rerank tier</b> · 10K rps<br/>top-50 shortlist only<br/>batched · budget-gated<br/>sheds, never queues<br/>cache (query, cands, model ver)"]
    DOC[("<b>Document store</b> — source of truth<br/>id, fields, aclIds[], version")]
    IX["<b>Indexer</b><br/>immutable segments<br/>tombstones on delete<br/>background merge"]

    CL -->|"1 search"| QC
    QC -->|"2 scatter, deadline attached"| SH1
    QC --> SH2
    QC --> SHN
    QC -.->|"hedge to 2nd replica past p95"| SH1
    SH1 -->|"3 top-k + scores"| MG
    SH2 --> MG
    SHN --> MG
    MG -->|"4 if budget remains"| LLM
    LLM -->|"5 reordered"| MG
    MG -->|"6 hits + cursor + indexVersion"| CL
    DOC -.->|"change stream"| IX
    IX -.->|"publish segment version"| SH1
    IX -.-> SH2
    IX -.-> SHN
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px,color:#111111;
    class CL,QC,SH1,SH2,SHN,MG,LLM,DOC,IX n;
    linkStyle 0,1,2,3,5,6,7,8,9,10 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 4,11,12,13,14 stroke:#7a2f6d,stroke-width:1.6px;
