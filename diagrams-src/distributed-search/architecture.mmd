%% section: Design
%% caption: Architecture — scatter-gather, tail control, optional rerank
flowchart LR
    CL("<b>Client</b><br/><span style='font-size:12px;color:#555'>q · k=20 · filters · cursor</span>")
    QC("<b>Query coordinator</b><br/><span style='font-size:12px;color:#555'>parse · rewrite · plan once<br/>absolute deadline set here<br/>caps pagination depth</span>")
    SH("<b>~100 shards × 3 replicas</b><br/><span style='font-size:12px;color:#555'>~30 GB in memory each<br/>ACL filter during match<br/>local top-k heap<br/>hedge past shard p95</span>")
    MG("<b>Merge</b><br/><span style='font-size:12px;color:#555'>100 lists → global top-k<br/>global IDF so scores compare<br/>partial flag + coverage</span>")
    LM("<b>LLM rerank</b> · 10K rps<br/><span style='font-size:12px;color:#555'>top-50 shortlist only<br/>batched · budget-gated<br/>sheds, never queues</span>")
    DO("<b>Document store</b><br/><span style='font-family:Menlo,monospace;font-size:11.5px;color:#333'>id, fields, aclIds[], version<br/>source of truth</span>")
    IX("<b>Indexer</b><br/><span style='font-family:Menlo,monospace;font-size:11.5px;color:#333'>immutable segments<br/>tombstones on delete<br/>background merge</span>")

    CL -->|"1 search"| QC
    QC -->|"2 scatter + deadline"| SH
    SH -->|"3 top-k + scores"| MG
    MG -->|"4 if budget remains"| LM
    LM -->|"5 reordered"| MG
    MG -->|"6 hits + cursor + indexVersion"| CL
    DO -.->|"change stream"| IX
    IX -.->|"publish segment version"| SH
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class CL,QC,SH,MG,LM,DO,IX n;
    linkStyle 0,1,2,3,4,5 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 6,7 stroke:#7a2f6d,stroke-width:1.6px;
