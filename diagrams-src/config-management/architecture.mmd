%% section: Page 2 — Architecture & LinkedIn Integration
%% caption: Clients cache last-known-good and never block startup on the config service. Stale beats down, and a bad value is one revert away.
flowchart LR
    AUT("<b>Author</b><br/><span style='font-size:11px;color:#555'>change + review<br/>schema validated in CI</span>")
    STORE("<b>Config store</b><br/><span style='font-size:11px;color:#555'>versioned, immutable history<br/>one mutable pointer per key<br/>CAS on expected version</span>")
    DIST("<b>Distribution</b><br/><span style='font-size:11px;color:#555'>watch / long-poll<br/>observers absorb fan-out<br/>jittered reconnect</span>")
    CLI("<b>Client library</b><br/><span style='font-size:11px;color:#555'>validate before apply<br/>last-known-good on disk<br/>reports applied version</span>")
    CAN("<b>Canary cohort</b><br/><span style='font-size:11px;color:#555'>subset picks up first<br/>bake before fleet-wide</span>")
    DRIFT("<b>Drift detection</b><br/><span style='font-size:11px;color:#555'>applied vs intended<br/>per host, continuously</span>")

    AUT -->|"<span style='font-size:11px;color:#2f4fd0'>1 CAS write</span>"| STORE
    STORE -->|"<span style='font-size:11px;color:#2f4fd0'>2 notify, no payload</span>"| DIST
    DIST -->|"<span style='font-size:11px;color:#2f4fd0'>3 canary first</span>"| CAN
    DIST -->|"<span style='font-size:11px;color:#2f4fd0'>4 then fleet</span>"| CLI
    CLI -.->|"<span style='font-size:11px;color:#c2410c'>5 applied version</span>"| DRIFT
    CAN -.->|"<span style='font-size:11px;color:#c2410c'>bake result</span>"| DIST
    STORE -.->|"<span style='font-size:11px;color:#c2410c'>revert = previous version, one write</span>"| DIST
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class AUT,STORE,DIST,CLI,CAN,DRIFT n;
    linkStyle 0,1,2,3 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 4,5,6 stroke:#c2410c,stroke-width:1.6px;
