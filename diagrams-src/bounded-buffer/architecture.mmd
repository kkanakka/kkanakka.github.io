%% section: Design
%% caption: One mutex guards every field, so no thread can check a predicate and then sleep through the notification. The bound is the back-pressure.
flowchart LR
    P("<b>Producers</b><br/><span style='font-size:11px;color:#555'>put(item)<br/>block while full</span>")
    L("<b>One mutex</b><br/><span style='font-size:11px;color:#555'>guards queue, closed flag<br/>and both conditions</span>")
    NF("<b>not_full</b><br/><span style='font-size:11px;color:#555'>while(len==cap) wait<br/>notify() = one waiter</span>")
    RB("<b>Ring buffer</b><br/><span style='font-size:11px;color:#555'>fixed capacity<br/>the bound IS the limiter</span>")
    NE("<b>not_empty</b><br/><span style='font-size:11px;color:#555'>while(empty) wait<br/>re-check on wake</span>")
    C("<b>Consumers</b><br/><span style='font-size:11px;color:#555'>take() → item<br/>block while empty</span>")
    CL("<b>close()</b><br/><span style='font-size:11px;color:#555'>notify_all both<br/>producers raise<br/>consumers drain then stop</span>")

    P -->|"<span style='font-size:11px;color:#2f4fd0'>1 lock</span>"| L
    L -->|"<span style='font-size:11px;color:#2f4fd0'>2 full → wait</span>"| NF
    L -->|"<span style='font-size:11px;color:#2f4fd0'>3 append</span>"| RB
    RB -->|"<span style='font-size:11px;color:#2f4fd0'>4 notify(not_empty)</span>"| NE
    NE -->|"<span style='font-size:11px;color:#2f4fd0'>5 wake one</span>"| C
    C -->|"<span style='font-size:11px;color:#2f4fd0'>6 popleft → notify(not_full)</span>"| NF
    CL -.->|"<span style='font-size:11px;color:#c2410c'>the only notify_all</span>"| L
