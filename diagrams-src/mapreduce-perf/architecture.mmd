%% section: Design
%% caption: Profile first. The typical slow job is 60% shuffle and 5% compute, so optimising the compute first is the classic wasted week.
flowchart LR
    PROF("<b>Profiler</b><br/><span style='font-size:11px;color:#555'>task time histogram<br/>bytes shuffled per task<br/>locality % · skew</span>")
    IN("<b>Input layout</b><br/><span style='font-size:11px;color:#555'>columnar + pushdown<br/>bigger splits<br/>co-locate with compute</span>")
    MAP("<b>Map stage</b><br/><span style='font-size:11px;color:#555'>combiner (assoc + comm only)<br/>broadcast small join side<br/>reuse objects</span>")
    SHUF("<b>Shuffle</b><br/><span style='font-size:11px;color:#555'>LZ4 map output<br/>bigger sort buffer<br/>watch spill count</span>")
    RED("<b>Reduce stage</b><br/><span style='font-size:11px;color:#555'>reducers ~1.5x slots<br/>salt hot keys + 2nd pass<br/>speculative for slow nodes</span>")
    OUT("<b>Output commit</b><br/><span style='font-size:11px;color:#555'>temp then commit<br/>retries cannot double-write</span>")

    PROF -->|"<span style='font-size:11px;color:#2f4fd0'>1 largest bar first</span>"| IN
    IN -->|"<span style='font-size:11px;color:#2f4fd0'>2 data-local maps up</span>"| MAP
    MAP -->|"<span style='font-size:11px;color:#2f4fd0'>3 bytes down 20x</span>"| SHUF
    SHUF -->|"<span style='font-size:11px;color:#2f4fd0'>4 balanced input</span>"| RED
    RED --> OUT
    OUT -.->|"<span style='font-size:11px;color:#c2410c'>5 re-profile; verify byte-identical</span>"| PROF
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class PROF,IN,MAP,SHUF,RED,OUT n;
    linkStyle 0,1,2,3,4 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 5 stroke:#c2410c,stroke-width:1.6px;
