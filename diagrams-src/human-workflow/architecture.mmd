%% section: Design
%% caption: The queue mechanics are the easy part. Hiding the queue, gold tasks and trust routing are what make the output worth anything.
flowchart LR
    OPR("<b>Operator</b><br/><span style='font-size:11px;color:#555'>create batch<br/>watch p95 queue age<br/>and what is stuck</span>")
    BAT("<b>Batch API</b><br/><span style='font-size:11px;color:#555'>one row per task<br/>skills · priority<br/>payload → object store</span>")
    DB("<b>Task store</b><br/><span style='font-size:11px;color:#555'>state, owner, lease_until<br/>attempts, answer<br/>SKIP LOCKED claim</span>")
    W("<b>Worker UI</b><br/><span style='font-size:11px;color:#555'>asks for work, never browses<br/>autosaves drafts<br/>heartbeats while open</span>")
    RE("<b>Reaper</b><br/><span style='font-size:11px;color:#555'>expired lease → AVAILABLE<br/>attempts++ at claim time<br/>N attempts → escalate</span>")
    REV("<b>Review</b><br/><span style='font-size:11px;color:#555'>none | N-of-M | reviewer<br/>policy set per batch</span>")
    GOLD("<b>Gold tasks</b><br/><span style='font-size:11px;color:#555'>known answers, seeded<br/>invisibly · trust score</span>")
    AUD("<b>Audit log</b><br/><span style='font-size:11px;color:#555'>every transition<br/>actor · time · answer<br/>settles disputes</span>")

    OPR --> BAT --> DB
    W -->|"<span style='font-size:11px;color:#2f4fd0'>1 claim (server picks)</span>"| DB
    DB -->|"<span style='font-size:11px;color:#2f4fd0'>2 task + lease</span>"| W
    W -->|"<span style='font-size:11px;color:#2f4fd0'>3 heartbeat</span>"| DB
    W -->|"<span style='font-size:11px;color:#2f4fd0'>4 submit (guarded)</span>"| DB
    DB -->|"<span style='font-size:11px;color:#2f4fd0'>5 if policy requires</span>"| REV
    REV -.->|"<span style='font-size:11px;color:#c2410c'>reject → AVAILABLE + feedback</span>"| DB
    RE -.->|"<span style='font-size:11px;color:#c2410c'>abandonment needs no detector</span>"| DB
    GOLD -.->|"<span style='font-size:11px;color:#c2410c'>mixed into the stream</span>"| DB
    DB -.->|"<span style='font-size:11px;color:#c2410c'>every edge</span>"| AUD
    DB -.->|"<span style='font-size:11px;color:#c2410c'>progress + queue age</span>"| OPR
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class OPR,BAT,DB,W,RE,REV,GOLD,AUD n;
    linkStyle 0,1,2,3,4,5 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 6,7,8,9,10 stroke:#c2410c,stroke-width:1.6px;
