%% section: Design
%% caption: Output key is a pure function of the work, so a duplicated run overwrites identical bytes. At-least-once delivery, exactly-once effect.
flowchart LR
    EV("<b>Upload / backfill</b><br/><span style='font-size:11px;color:#555'>115/s avg · 1K/s peak<br/>backfills of 100M</span>")
    API("<b>Job API</b><br/><span style='font-size:11px;color:#555'>dedupeKey = hash(img, ops, ver)<br/>UNIQUE constraint<br/>202 jobId</span>")
    Q("<b>Queue</b><br/><span style='font-size:11px;color:#555'>visibility timeout 5m<br/>separate lane for backfill</span>")
    W("<b>Workers</b><br/><span style='font-size:11px;color:#555'>header check BEFORE decode<br/>memory + wall-clock caps<br/>autoscale on depth, to zero</span>")
    OBJ("<b>Object store</b><br/><span style='font-size:11px;color:#555'>out/{hash}/resize512/v3<br/>if-none-match</span>")
    ST("<b>Status store</b><br/><span style='font-size:11px;color:#555'>per-step rows<br/>attempts, error</span>")
    DLQ("<b>DLQ</b><br/><span style='font-size:11px;color:#555'>attempts >= 3<br/>monitored, not a bin</span>")

    EV --> API
    API -->|"<span style='font-size:11px;color:#2f4fd0'>1 job CREATED</span>"| ST
    API -->|"<span style='font-size:11px;color:#2f4fd0'>2 enqueue decode</span>"| Q
    W -->|"<span style='font-size:11px;color:#2f4fd0'>3 receive</span>"| Q
    W -->|"<span style='font-size:11px;color:#2f4fd0'>4 fan-out resize, score</span>"| Q
    W -->|"<span style='font-size:11px;color:#2f4fd0'>5 PUT then ack</span>"| OBJ
    W -->|"<span style='font-size:11px;color:#2f4fd0'>6 step DONE</span>"| ST
    Q -.->|"<span style='font-size:11px;color:#c2410c'>poison after 3 tries</span>"| DLQ
    ST -.->|"<span style='font-size:11px;color:#c2410c'>all done → notify</span>"| API
