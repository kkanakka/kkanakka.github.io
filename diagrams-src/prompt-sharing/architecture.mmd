%% section: Design
%% caption: The index is a fast candidate generator, never the authority on access. Pre-filter for speed, recheck for correctness.
flowchart LR
    U("<b>User</b><br/><span style='font-size:11px;color:#555'>create · fork · share<br/>search</span>")
    PS("<b>Prompt service</b><br/><span style='font-size:11px;color:#555'>head → immutable versions<br/>fork records source version<br/>secret scan on save</span>")
    PG("<b>Postgres</b><br/><span style='font-size:11px;color:#555'>prompts(headVersionId)<br/>prompt_versions(bodyRef, hash)<br/>shares(grantee, role)</span>")
    PERM("<b>Permission svc</b><br/><span style='font-size:11px;color:#555'>visibility ∪ shares ∪ roles<br/>cached per (user, prompt)<br/>invalidated on share change</span>")
    CDC("<b>CDC</b><br/><span style='font-size:11px;color:#555'>no dual writes<br/>index outage ≠ publish outage</span>")
    ES("<b>Search index</b><br/><span style='font-size:11px;color:#555'>text + tags + model<br/>visibility, teamIds[]<br/>decayed popularity</span>")
    SA("<b>Search API</b><br/><span style='font-size:11px;color:#555'>pre-filter in query<br/>batch recheck before return<br/>fail closed</span>")

    U --> PS
    PS -->|"<span style='font-size:11px;color:#2f4fd0'>1 insert version</span>"| PG
    PS -->|"<span style='font-size:11px;color:#2f4fd0'>2 invalidate ACL cache</span>"| PERM
    PG -.->|"<span style='font-size:11px;color:#c2410c'>3 change stream</span>"| CDC
    CDC -.->|"<span style='font-size:11px;color:#c2410c'>4 reindex</span>"| ES
    U -->|"<span style='font-size:11px;color:#2f4fd0'>5 search</span>"| SA
    SA -->|"<span style='font-size:11px;color:#2f4fd0'>6 text AND visibility</span>"| ES
    SA -->|"<span style='font-size:11px;color:#2f4fd0'>7 recheck the page</span>"| PERM
    PERM --> PG
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class U,PS,PG,PERM,CDC,ES,SA n;
    linkStyle 0,1,2,5,6,7,8 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 3,4 stroke:#c2410c,stroke-width:1.6px;
