%% section: Design
%% caption: Architecture — sockets, ordering, durable inbox, delivery receipts
flowchart LR
    A("<b>User A</b><br/><span style='font-size:12px;color:#555'>phone</span>")
    B("<b>User B</b><br/><span style='font-size:12px;color:#555'>phone + laptop</span>")
    LB("<b>L4 LB</b><br/><span style='font-size:12px;color:#555'>TCP pass-through<br/>least-connections</span>")
    W1("<b>WS server 1</b><br/><span style='font-size:12px;color:#555'>holds A's socket<br/>SUBSCRIBE user:A<br/>~100K conns / box</span>")
    W2("<b>WS server 2</b><br/><span style='font-size:12px;color:#555'>holds B's sockets<br/>SUBSCRIBE user:B<br/>stateless apart from sockets</span>")
    MS("<b>Message Service</b><br/><span style='font-size:12px;color:#555'>dedupe by client_message_id<br/>seq = INCR seq:conv<br/>INSERT (sync, durable)<br/>fan-out to B's device inboxes<br/>PUBLISH user:B</span>")
    RD("<b>Redis Cluster</b><br/><span style='font-family:Menlo,monospace;font-size:11.5px;color:#333'>seq:{conv} INCR<br/>inbox:{device} LIST<br/>inflight:{device} LIST<br/>user:{id} PUB/SUB<br/>presence:{id} TTL 60s<br/>idem:{sender}:{cmid} TTL</span>")
    PG("<b>Postgres, sharded by conversation_id</b><br/><span style='font-family:Menlo,monospace;font-size:11.5px;color:#333'>messages UNIQUE(conv, seq)<br/>UNIQUE(conv, sender, cmid)<br/>idx (conv, seq DESC)<br/>message_status (msg, device)<br/>read_receipts (user, conv, hwm)<br/>user_conversations index table</span>")

    A -->|"WS upgrade"| LB
    LB --> W1
    W1 -->|"1 send"| MS
    MS -->|"2 INCR · 4 LPUSH · 5 PUBLISH"| RD
    MS -->|"3 INSERT"| PG
    RD -.->|"6 notify (sub)"| W2
    W2 -.->|"7 BRPOPLPUSH inbox → inflight"| RD
    W2 -.->|"8 deliver"| LB
    LB -.-> B
    W2 -.->|"9 ACK → LREM inflight<br/>status=delivered → PUBLISH user:A"| MS
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class A,B,LB,W1,W2,MS,RD,PG n;
    linkStyle 0,1,2,3,4 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 5,6,7,8,9 stroke:#c2410c,stroke-width:1.6px;
