flowchart TB
    T["tokenizing 'tokenizer rize' with vocab<br/>token=1 tok=2 ize=4 r=5 i=6 z=7"]
    subgraph O["out — one tuple per emitted token"]
        direction LR
        O1["(1, 'token')"] --- O2["(4, 'ize')"] --- O3["(5, 'r')"] --- O4["(-1, ' ')"] --- O5["(5, 'r')"] --- O6["(4, 'ize')"]
