%% section: Design
%% caption: Server memory is a function of connection count, never of how slow those connections are. Zero-copy plus stop-reading is the whole answer.
flowchart LR
    CL("<b>Clients</b><br/><span style='font-size:11px;color:#555'>100K concurrent streams<br/>uploads to TB · Range GETs</span>")
    LB("<b>L4 LB</b><br/><span style='font-size:11px;color:#555'>packets, not streams<br/>route by object hash</span>")
    CP("<b>Control plane</b><br/><span style='font-size:11px;color:#555'>auth · quota · session<br/>once per transfer, not per byte</span>")
    IO("<b>I/O node</b><br/><span style='font-size:11px;color:#555'>io_uring / epoll<br/>1 MB bounded buffer<br/>TCP window = back-pressure<br/>sendfile / splice out</span>")
    NVM("<b>NVMe staging</b><br/><span style='font-size:11px;color:#555'>absorbs at local speed<br/>cache, never the record</span>")
    OBJ("<b>Object store</b><br/><span style='font-size:11px;color:#555'>durable after commit<br/>ranged reads on miss</span>")
    MAN("<b>Manifest commit</b><br/><span style='font-size:11px;color:#555'>parts + etags verified<br/>the moment it exists</span>")

    CL --> LB --> IO
    IO -->|"<span style='font-size:11px;color:#2f4fd0'>1 auth, create session</span>"| CP
    IO -->|"<span style='font-size:11px;color:#2f4fd0'>2 write part</span>"| NVM
    NVM -.->|"<span style='font-size:11px;color:#c2410c'>3 async flush</span>"| OBJ
    IO -->|"<span style='font-size:11px;color:#2f4fd0'>4 complete</span>"| MAN
    MAN -->|"<span style='font-size:11px;color:#2f4fd0'>5 now readable</span>"| CP
    OBJ -->|"<span style='font-size:11px;color:#2f4fd0'>6 range fetch on miss</span>"| IO
    IO -.->|"<span style='font-size:11px;color:#c2410c'>slow client → stop reading source</span>"| CL
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class CL,LB,CP,IO,NVM,OBJ,MAN n;
    linkStyle 0,1,2,4,5,6 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 3,7 stroke:#c2410c,stroke-width:1.6px;
