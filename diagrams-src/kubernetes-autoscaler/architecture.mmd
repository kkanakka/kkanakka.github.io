%% section: Page 2 — Architecture & Feedback Control Implementation
%% caption: Scale on a signal that leads user pain, not one that trails it. Scaling up is cheap and reversible, scaling down is not, so the two directions get different rules.
flowchart LR
    MET("<b>Metrics source</b><br/><span style='font-size:11px;color:#555'>queue depth · in-flight<br/>saturation leads latency<br/>CPU trails it</span>")
    CTL("<b>Autoscaler</b><br/><span style='font-size:11px;color:#555'>error = observed − target<br/>proportional + damping<br/>asymmetric up and down</span>")
    POL("<b>Policy</b><br/><span style='font-size:11px;color:#555'>min / max replicas<br/>scale-down stabilisation<br/>cooldown between actions</span>")
    K8S("<b>Kubernetes API</b><br/><span style='font-size:11px;color:#555'>replica count only<br/>scheduler does placement</span>")
    POD("<b>Pods</b><br/><span style='font-size:11px;color:#555'>readiness gates traffic<br/>warm up before counted</span>")
    CA("<b>Cluster autoscaler</b><br/><span style='font-size:11px;color:#555'>nodes take minutes<br/>headroom buys that time</span>")

    MET -->|"<span style='font-size:11px;color:#2f4fd0'>1 observe</span>"| CTL
    CTL -->|"<span style='font-size:11px;color:#2f4fd0'>2 clamp to policy</span>"| POL
    POL -->|"<span style='font-size:11px;color:#2f4fd0'>3 set replicas</span>"| K8S
    K8S -->|"<span style='font-size:11px;color:#2f4fd0'>4 schedule</span>"| POD
    POD -.->|"<span style='font-size:11px;color:#c2410c'>5 ready → serves → moves the metric</span>"| MET
    K8S -.->|"<span style='font-size:11px;color:#c2410c'>no room → add nodes</span>"| CA
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class MET,CTL,POL,K8S,POD,CA n;
    linkStyle 0,1,2,3 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 4,5 stroke:#c2410c,stroke-width:1.6px;
