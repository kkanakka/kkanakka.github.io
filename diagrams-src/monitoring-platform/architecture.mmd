%% section: 3 · Architecture
%% caption: Alert evaluation sits in its own failure domain with its own data path, because monitoring that depends on the system it watches goes blind during the incidents that matter.
flowchart LR
    AG("<b>Agents</b><br/><span style='font-size:11px;color:#555'>scrape 15s · pre-aggregate<br/>drop oldest, count the drop</span>")
    ING("<b>Ingest</b><br/><span style='font-size:11px;color:#555'>label allowlist<br/>per-tenant series budget<br/>reject new series over budget</span>")
    LOG("<b>Durable log</b><br/><span style='font-size:11px;color:#555'>partitioned by series hash<br/>independent consumers</span>")
    TS("<b>TSDB shards</b><br/><span style='font-size:11px;color:#555'>head block, compressed<br/>2h blocks · inverted index</span>")
    CMP("<b>Compactor</b><br/><span style='font-size:11px;color:#555'>5m / 1h rollups<br/>keeps histogram buckets</span>")
    Q("<b>Query</b><br/><span style='font-size:11px;color:#555'>fan out to owning shards<br/>resolution chosen by range</span>")
    EV("<b>Alert evaluator</b><br/><span style='font-size:11px;color:#555'>own 2h store, own consumer<br/>burn rate · absence rules</span>")
    PG("<b>Pager</b><br/><span style='font-size:11px;color:#555'>dedupe and group<br/>dead-man heartbeat out</span>")

    AG -->|"<span style='font-size:11px;color:#2f4fd0'>1 batched write</span>"| ING
    ING -->|"<span style='font-size:11px;color:#2f4fd0'>2 append</span>"| LOG
    LOG -->|"<span style='font-size:11px;color:#2f4fd0'>3 consume</span>"| TS
    TS --> CMP
    Q -->|"<span style='font-size:11px;color:#2f4fd0'>4 read</span>"| TS
    LOG -.->|"<span style='font-size:11px;color:#c2410c'>5 separate consumer, never via query</span>"| EV
    EV -.->|"<span style='font-size:11px;color:#c2410c'>6 fire</span>"| PG
