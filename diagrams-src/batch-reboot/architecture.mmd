%% section: Design
%% caption: A reboot tool is an admission controller that happens to reboot things. Every interesting step is a permission check, and the correct answer is often "no".
flowchart LR
    OP("<b>Operator</b><br/><span style='font-size:11px;color:#555'>selector + reason + ticket<br/>echoes expected count<br/>2nd approver if large</span>")
    API("<b>Job API</b><br/><span style='font-size:11px;color:#555'>resolve · dry run<br/>blast radius per service<br/>start / pause / abort</span>")
    INV("<b>Inventory</b><br/><span style='font-size:11px;color:#555'>machine → failure domain<br/>machine → services[]<br/>unreachable = refuse</span>")
    SCH("<b>Scheduler</b><br/><span style='font-size:11px;color:#555'>spread across domains<br/>canary of one first<br/>caps: fleet · domain · service</span>")
    BUD("<b>Budget service</b><br/><span style='font-size:11px;color:#555'>reserve(service, machine)<br/>atomic · shared with<br/>organic failures</span>")
    TGT("<b>Target store</b><br/><span style='font-size:11px;color:#555'>state, owner, lease_until<br/>attempts, lastError<br/>audit event per edge</span>")
    EXE("<b>Executor</b><br/><span style='font-size:11px;color:#555'>cordon → drain → reboot<br/>→ boot → verify → uncordon<br/>3 timeouts, 3 meanings</span>")
    K8S("<b>Kubernetes</b><br/><span style='font-size:11px;color:#555'>PDB is a second veto<br/>blocked drain = information</span>")
    AGT("<b>Machine agent</b><br/><span style='font-size:11px;color:#555'>idempotent on token<br/>re-registers with version</span>")

    OP -->|"<span style='font-size:11px;color:#2f4fd0'>1 submit</span>"| API
    API -->|"<span style='font-size:11px;color:#2f4fd0'>2 resolve</span>"| INV
    API -->|"<span style='font-size:11px;color:#2f4fd0'>3 dry run back</span>"| OP
    API --> SCH
    SCH -->|"<span style='font-size:11px;color:#2f4fd0'>4 reserve</span>"| BUD
    SCH -->|"<span style='font-size:11px;color:#2f4fd0'>5 claim + lease</span>"| TGT
    SCH --> EXE
    EXE -->|"<span style='font-size:11px;color:#2f4fd0'>6 cordon + drain</span>"| K8S
    EXE -->|"<span style='font-size:11px;color:#2f4fd0'>7 reboot(token)</span>"| AGT
    AGT -.->|"<span style='font-size:11px;color:#c2410c'>8 re-register</span>"| EXE
    EXE -.->|"<span style='font-size:11px;color:#c2410c'>9 verify → uncordon</span>"| K8S
    EXE -.->|"<span style='font-size:11px;color:#c2410c'>release budget after verify</span>"| BUD
    EXE -.->|"<span style='font-size:11px;color:#c2410c'>halt wave on anomaly</span>"| SCH
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class OP,API,INV,SCH,BUD,TGT,EXE,K8S,AGT n;
    linkStyle 0,1,2,3,4,5,6,7,8 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 9,10,11,12 stroke:#c2410c,stroke-width:1.6px;
