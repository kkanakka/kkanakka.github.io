%% section: Design
%% caption: The cheapest request is the one never sent. Pool size comes from Little's law, not CPU count.
flowchart LR
    CAL("<b>Caller</b><br/><span style='font-size:11px;color:#555'>10K–10M requests<br/>streamed, not listed</span>")
    Q("<b>Queue</b><br/><span style='font-size:11px;color:#555'>dedupe key =<br/>method+url+body hash</span>")
    CA("<b>Cache</b><br/><span style='font-size:11px;color:#555'>ETag / Last-Modified<br/>hit skips the limiter</span>")
    LIM("<b>Limiter</b><br/><span style='font-size:11px;color:#555'>token bucket + inflight cap<br/>learned from headers<br/>both must be satisfied</span>")
    W("<b>Workers</b><br/><span style='font-size:11px;color:#555'>size = throughput x latency<br/>keep-alive · HTTP/2 · gzip</span>")
    API("<b>Target API</b><br/><span style='font-size:11px;color:#555'>200 / 304 / 429 / 5xx</span>")
    CP("<b>Checkpoint</b><br/><span style='font-size:11px;color:#555'>done ids, durable<br/>resume = set difference</span>")

    CAL --> Q
    Q -->|"<span style='font-size:11px;color:#2f4fd0'>1 cached fresh?</span>"| CA
    Q -->|"<span style='font-size:11px;color:#2f4fd0'>2 acquire(key)</span>"| LIM
    LIM -->|"<span style='font-size:11px;color:#2f4fd0'>3 go</span>"| W
    W -->|"<span style='font-size:11px;color:#2f4fd0'>4 If-None-Match</span>"| API
    API -.->|"<span style='font-size:11px;color:#c2410c'>5 update budget from headers</span>"| LIM
    W --> CA
    W -.->|"<span style='font-size:11px;color:#c2410c'>429 → pause key until Retry-After</span>"| LIM
    W -.->|"<span style='font-size:11px;color:#c2410c'>6 done id</span>"| CP
    CP -.->|"<span style='font-size:11px;color:#c2410c'>resume after crash</span>"| Q
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class CAL,Q,CA,LIM,W,API,CP n;
    linkStyle 0,1,2,3,4,6 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 5,7,8,9 stroke:#c2410c,stroke-width:1.6px;
