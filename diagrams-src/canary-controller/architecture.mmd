%% section: 3 · Architecture
%% caption: The controller only ever moves a routing weight. Both versions serve throughout, so halting costs nothing and needs no recovery.
flowchart LR
    OP("<b>Operator / CI</b><br/><span style='font-size:11px;color:#555'>start canary for a version<br/>plan 1 → 5 → 25 → 100</span>")
    CTL("<b>Canary controller</b><br/><span style='font-size:11px;color:#555'>reconciles to desired stage<br/>owns the bake timers<br/>halt is the default action</span>")
    REG("<b>Version registry</b><br/><span style='font-size:11px;color:#555'>immutable versions<br/>one mutable current pointer</span>")
    RT("<b>Router</b><br/><span style='font-size:11px;color:#555'>weight per version<br/>pins a request for its lifetime</span>")
    OLD("<b>Stable fleet</b><br/><span style='font-size:11px;color:#555'>serves the remainder<br/>kept warm for rollback</span>")
    NEW("<b>Canary fleet</b><br/><span style='font-size:11px;color:#555'>new version<br/>scaled to the stage weight</span>")
    SLI("<b>SLI evaluator</b><br/><span style='font-size:11px;color:#555'>burn rate vs stable<br/>same traffic slice<br/>absent signal = fail</span>")

    OP -->|"<span style='font-size:11px;color:#2f4fd0'>1 start</span>"| CTL
    CTL -->|"<span style='font-size:11px;color:#2f4fd0'>2 read / flip pointer</span>"| REG
    CTL -->|"<span style='font-size:11px;color:#2f4fd0'>3 set weights</span>"| RT
    RT -->|"<span style='font-size:11px;color:#2f4fd0'>4 majority</span>"| OLD
    RT -->|"<span style='font-size:11px;color:#2f4fd0'>5 canary share</span>"| NEW
    NEW -.->|"<span style='font-size:11px;color:#c2410c'>6 metrics</span>"| SLI
    OLD -.->|"<span style='font-size:11px;color:#c2410c'>baseline</span>"| SLI
    SLI -.->|"<span style='font-size:11px;color:#c2410c'>7 pass → next stage · fail → weight 0</span>"| CTL
