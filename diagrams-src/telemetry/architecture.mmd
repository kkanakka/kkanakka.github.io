%% section: Design
%% caption: Raw store is the system of record and is never rewritten. Canonical series are a derived view under a mapping_version, so a wrong alias is fixed by re-deriving, not by guessing.
flowchart LR
    SDK("<b>Client SDK</b><br/><span style='font-size:11px;color:#555'>v1.2 … v4.0<br/>buffer · batch · backoff</span>")
    ING("<b>Ingest edge</b><br/><span style='font-size:11px;color:#555'>auth · schema · limits<br/>dedupe (client,batch,seq)<br/>202, no resolution</span>")
    KAF("<b>Kafka</b><br/><span style='font-size:11px;color:#555'>raw · replayable</span>")
    RES("<b>Resolver</b><br/><span style='font-size:11px;color:#555'>(ns, name, version) → metric_id<br/>unit convert · label cap<br/>stamp mapping_version</span>")
    REG("<b>Metric Registry</b><br/><span style='font-size:11px;color:#555'>identity: type, unit, owner<br/>alias: scoped, versioned,<br/>evidence, valid range</span>")
    RAW("<b>Raw store</b><br/><span style='font-size:11px;color:#555'>as sent + provenance<br/>immutable</span>")
    TSDB("<b>Canonical TSDB</b><br/><span style='font-size:11px;color:#555'>series by metric_id<br/>derived · rebuildable</span>")
    QUA("<b>Quarantine</b><br/><span style='font-size:11px;color:#555'>raw:&lt;name&gt; · never merged<br/>review queue</span>")
    API("<b>Query API</b><br/><span style='font-size:11px;color:#555'>expand aliases by range<br/>provenance · resolve=raw</span>")
    OWN("<b>Owners / review</b><br/><span style='font-size:11px;color:#555'>propose · evidence<br/>approve · revoke</span>")
    BF("<b>Backfill job</b><br/><span style='font-size:11px;color:#555'>raw → canonical<br/>on mapping change</span>")

    SDK --> ING --> KAF --> RES
    RES -->|"<span style='font-size:11px;color:#2f4fd0'>lookup</span>"| REG
    RES -->|"<span style='font-size:11px;color:#2f4fd0'>raw + prov</span>"| RAW
    RES -->|"<span style='font-size:11px;color:#2f4fd0'>canonical</span>"| TSDB
    RES -->|"<span style='font-size:11px;color:#2f4fd0'>unresolved</span>"| QUA
    RAW --> API
    TSDB --> API
    REG -.->|"<span style='font-size:11px;color:#2f4fd0'>alias expansion</span>"| API
    OWN -.->|"<span style='font-size:11px;color:#c2410c'>approve / revoke</span>"| REG
    OWN -.-> BF
    BF -.->|"<span style='font-size:11px;color:#c2410c'>read raw</span>"| RAW
    BF -.->|"<span style='font-size:11px;color:#c2410c'>rewrite</span>"| TSDB
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class SDK,ING,KAF,RES,REG,RAW,TSDB,QUA,API,OWN,BF n;
    linkStyle 0,1,2,3,4,5,6 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 7,8,9,10,11 stroke:#c2410c,stroke-width:1.6px;
