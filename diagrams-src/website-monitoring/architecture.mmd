%% section: Design
%% caption: The hard question is never "did the check fail" but "did the site fail, or did we". Quorum, consecutive thresholds and self-monitoring all exist to answer it.
flowchart LR
    CUS("<b>Customer</b><br/><span style='font-size:11px;color:#555'>URL · interval · regions<br/>alert channels<br/>domain ownership verified</span>")
    SCH("<b>Scheduler</b><br/><span style='font-size:11px;color:#555'>sorted by next_run<br/>jitter at creation<br/>1M x 5 / 60s ≈ 83K/s</span>")
    CHK("<b>Checkers</b> (per region)<br/><span style='font-size:11px;color:#555'>resolve then validate IP<br/>timeout · size · redirect caps<br/>classify, not boolean</span>")
    TS("<b>Result store</b><br/><span style='font-size:11px;color:#555'>latency histograms by phase<br/>cert expiry per TLS check<br/>uptime is billing-grade</span>")
    EV("<b>Evaluator</b><br/><span style='font-size:11px;color:#555'>k-of-n region quorum<br/>N consecutive failures<br/>maintenance suppression</span>")
    AL("<b>Alerting</b><br/><span style='font-size:11px;color:#555'>dedupe + group by cause<br/>400 down = 1 page<br/>always send resolution</span>")
    SP("<b>Status page</b><br/><span style='font-size:11px;color:#555'>separate provider + DNS<br/>static, different domain</span>")
    SELF("<b>Self-monitoring</b><br/><span style='font-size:11px;color:#555'>known-bad must alert<br/>external dead-man switch</span>")

    CUS --> SCH
    SCH -->|"<span style='font-size:11px;color:#2f4fd0'>1 one job per (monitor, region)</span>"| CHK
    CHK -->|"<span style='font-size:11px;color:#2f4fd0'>2 results</span>"| TS
    TS -->|"<span style='font-size:11px;color:#2f4fd0'>3 quorum + threshold</span>"| EV
    EV -->|"<span style='font-size:11px;color:#2f4fd0'>4 state transition</span>"| AL
    AL -->|"<span style='font-size:11px;color:#2f4fd0'>5 notify with evidence</span>"| CUS
    TS -.->|"<span style='font-size:11px;color:#c2410c'>uptime, maintenance excluded</span>"| SP
    EV -.->|"<span style='font-size:11px;color:#c2410c'>region unhealthy → drop from vote</span>"| CHK
    SELF -.->|"<span style='font-size:11px;color:#c2410c'>who watches the watcher</span>"| AL
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class CUS,SCH,CHK,TS,EV,AL,SP,SELF n;
    linkStyle 0,1,2,3,4,5 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 6,7,8 stroke:#c2410c,stroke-width:1.6px;
