%% section: Design
%% caption: Build and deploy are two systems joined by one immutable artifact. CI never holds cluster credentials — the cluster pulls, so a compromised pipeline can propose but not deploy.
flowchart LR
    DEV("<b>Developer</b><br/><span style='font-size:11px;color:#555'>merge to main<br/>branch protection = gate 1</span>")
    CI("<b>CI (ephemeral runner)</b><br/><span style='font-size:11px;color:#555'>hermetic · pinned deps<br/>test once, build once<br/>no cluster credentials</span>")
    REG("<b>Registry</b><br/><span style='font-size:11px;color:#555'>repo@sha256:… by digest<br/>never :latest</span>")
    ATT("<b>Attestation</b><br/><span style='font-size:11px;color:#555'>signature · provenance<br/>SBOM for CVE queries</span>")
    ENV("<b>Env repo (git)</b><br/><span style='font-size:11px;color:#555'>desired state per env<br/>promotion = reviewed commit<br/>revert = rollback</span>")
    REC("<b>Reconciler</b> (in cluster)<br/><span style='font-size:11px;color:#555'>pulls, never pushed to<br/>diff desired vs observed<br/>corrects drift continuously</span>")
    ADM("<b>Admission control</b><br/><span style='font-size:11px;color:#555'>signed images only<br/>no :latest · limits set<br/>independent of the pipeline</span>")
    PD("<b>Progressive delivery</b><br/><span style='font-size:11px;color:#555'>5 → 25 → 50 → 100%<br/>bake at each stage<br/>both versions serve</span>")
    GATE("<b>Gates</b><br/><span style='font-size:11px;color:#555'>vs previous version,<br/>same traffic slice<br/>missing signal = fail</span>")

    DEV -->|"<span style='font-size:11px;color:#2f4fd0'>1 merge</span>"| CI
    CI -->|"<span style='font-size:11px;color:#2f4fd0'>2 push by digest</span>"| REG
    CI -->|"<span style='font-size:11px;color:#2f4fd0'>3 sign + attest</span>"| ATT
    CI -->|"<span style='font-size:11px;color:#2f4fd0'>4 promotion commit</span>"| ENV
    REC -->|"<span style='font-size:11px;color:#2f4fd0'>5 pull desired state</span>"| ENV
    REC -->|"<span style='font-size:11px;color:#2f4fd0'>6 apply</span>"| ADM
    ADM -->|"<span style='font-size:11px;color:#2f4fd0'>7 admitted</span>"| PD
    PD -->|"<span style='font-size:11px;color:#2f4fd0'>8 evaluate</span>"| GATE
    ATT -.->|"<span style='font-size:11px;color:#c2410c'>verify at admission</span>"| ADM
    REG -.->|"<span style='font-size:11px;color:#c2410c'>image pull (often cached)</span>"| PD
    GATE -.->|"<span style='font-size:11px;color:#c2410c'>fail → halt + revert stage</span>"| PD
    ENV -.->|"<span style='font-size:11px;color:#c2410c'>git revert = rollback, works with CI down</span>"| REC
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class DEV,CI,REG,ATT,ENV,REC,ADM,PD,GATE n;
    linkStyle 0,1,2,3,4,5,6,7 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 8,9,10,11 stroke:#c2410c,stroke-width:1.6px;
