%% section: Design
%% caption: Bytes go direct to storage; the service only signs, authorises and records. Originals get eleven nines, derivatives are regenerable and live cheaper.
flowchart LR
    DEV("<b>Device</b><br/><span style='font-size:11px;color:#555'>sha256 + chunk<br/>parallel part upload<br/>resume from HEAD</span>")
    UP("<b>Upload svc</b><br/><span style='font-size:11px;color:#555'>hash exists for user?<br/>quota check<br/>signs part URLs</span>")
    OBJ("<b>Object store</b><br/><span style='font-size:11px;color:#555'>originals · 11 nines<br/>multipart assemble</span>")
    PROC("<b>Processing</b><br/><span style='font-size:11px;color:#555'>thumbs · display sizes<br/>HLS renditions<br/>strip EXIF</span>")
    DRV("<b>Derivatives</b><br/><span style='font-size:11px;color:#555'>+30% storage<br/>cheaper tier, regenerable</span>")
    META("<b>Metadata DB</b><br/><span style='font-size:11px;color:#555'>item ready + sizes[]<br/>home region · quota</span>")
    SH("<b>Sharing svc</b><br/><span style='font-size:11px;color:#555'>token stored, not signed<br/>checked on every view<br/>revoke = cache purge</span>")
    CDN("<b>CDN</b><br/><span style='font-size:11px;color:#555'>signed URLs, 5 min<br/>validates at the edge</span>")
    VIEW("<b>Viewer</b><br/><span style='font-size:11px;color:#555'>may be unauthenticated</span>")

    DEV -->|"<span style='font-size:11px;color:#2f4fd0'>1 POST hash</span>"| UP
    UP -->|"<span style='font-size:11px;color:#2f4fd0'>2 dedupe hit | part URLs</span>"| DEV
    DEV -->|"<span style='font-size:11px;color:#2f4fd0'>3 PUT parts direct</span>"| OBJ
    OBJ -.->|"<span style='font-size:11px;color:#c2410c'>4 completion event</span>"| PROC
    PROC --> DRV
    PROC -.->|"<span style='font-size:11px;color:#c2410c'>5 item ready</span>"| META
    SH -->|"<span style='font-size:11px;color:#2f4fd0'>6 valid? not revoked?</span>"| META
    VIEW -->|"<span style='font-size:11px;color:#2f4fd0'>GET /s/:token</span>"| SH
    SH -->|"<span style='font-size:11px;color:#2f4fd0'>7 signed CDN URLs</span>"| VIEW
    VIEW --> CDN
    CDN --> DRV
