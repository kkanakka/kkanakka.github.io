%% section: Design
%% caption: Architecture — identity, limits, metering, streaming contract
flowchart LR
    CL("<b>Developer client</b><br/><span style='font-size:12px;color:#555'>SDK · idempotency-key<br/>anthropic-version header</span>")
    ED("<b>Edge</b><br/><span style='font-size:12px;color:#555'>TLS · millions of streams<br/>resolves identity once<br/>4 limit layers, local µs</span>")
    AC("<b>Auth + buckets</b> (local, leased)<br/><span style='font-family:Menlo,monospace;font-size:11.5px;color:#333'>sha256(key) → org, scopes, tier<br/>reserve = prompt + max_tokens<br/>push-invalidated on revoke</span>")
    AS("<b>API service</b><br/><span style='font-size:12px;color:#555'>validate vs dated version<br/>idempotency short-circuit<br/>safety in + out</span>")
    IF("<b>Inference fleet</b><br/><span style='font-size:12px;color:#555'>admission · pool choice<br/>prefix-cache routing<br/>continuous batching</span>")
    ME("<b>Metering</b><br/><span style='font-size:12px;color:#555'>counts from the source<br/>idempotent on request_id</span>")
    PG("<b>Postgres</b><br/><span style='font-family:Menlo,monospace;font-size:11.5px;color:#333'>orgs, workspaces<br/>api_keys(hash, scopes, prefix)<br/>tier defaults + overrides</span>")
    RD("<b>Redis + ledger</b><br/><span style='font-family:Menlo,monospace;font-size:11.5px;color:#333'>quota:{key}:{window} Lua lease<br/>upsert (org, model, day)<br/>invoices read the ledger</span>")

    CL -->|"1 POST /v1/messages"| ED
    ED -->|"2 resolve + check"| AC
    ED -->|"429 + Retry-After"| CL
    ED -->|"3 forward w/ identity"| AS
    AS -->|"4 admitted"| IF
    IF -->|"5 SSE deltas, per-event id"| CL
    IF -.->|"6 usage event"| ME
    ME -.->|"7 counters + ledger"| RD
    PG -.->|"config, 60s TTL"| AC
    RD -.->|"lease ~5s"| AC
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class CL,ED,AC,AS,IF,ME,PG,RD n;
    linkStyle 0,1,2,3,4,5 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 6,7,8,9 stroke:#c2410c,stroke-width:1.6px;
