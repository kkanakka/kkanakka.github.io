%% section: Design
%% caption: Politeness is enforced at claim time, so no combination of workers can burst one host. The frontier is a stateful table, not a queue.
flowchart LR
    SEED("<b>Seeds / scheduler</b><br/><span style='font-size:11px;color:#555'>scope · depth · budget<br/>recrawl by change rate</span>")
    FR("<b>Frontier</b><br/><span style='font-size:11px;color:#555'>urls(state, owner, lease_until,<br/>attempts, priority, depth)<br/>idx(state, lease_until)</span>")
    HOST("<b>Host table</b><br/><span style='font-size:11px;color:#555'>robots · crawl_delay<br/>next_allowed_at · failures</span>")
    FW("<b>Fetcher workers</b><br/><span style='font-size:11px;color:#555'>claim only if timer expired<br/>timeout · size cap · UA<br/>conditional GET</span>")
    BLOB("<b>Blob store</b><br/><span style='font-size:11px;color:#555'>raw HTML by content hash<br/>ingestion boundary</span>")
    PAR("<b>Parser</b><br/><span style='font-size:11px;color:#555'>extract · canonicalize<br/>strip session ids</span>")
    DUP("<b>Dedupe</b><br/><span style='font-size:11px;color:#555'>Bloom: seen(url)?<br/>simhash: near-duplicate<br/>atomic test-and-set</span>")
    REAP("<b>Reaper</b><br/><span style='font-size:11px;color:#555'>lease expired → pending<br/>attempts++ · park bad hosts</span>")

    SEED --> FR
    FW -->|"<span style='font-size:11px;color:#2f4fd0'>1 claim + lease</span>"| FR
    FW -->|"<span style='font-size:11px;color:#2f4fd0'>2 robots / delay</span>"| HOST
    FW -->|"<span style='font-size:11px;color:#2f4fd0'>3 store raw</span>"| BLOB
    BLOB --> PAR
    PAR -->|"<span style='font-size:11px;color:#2f4fd0'>4 seen?</span>"| DUP
    DUP -->|"<span style='font-size:11px;color:#2f4fd0'>5 new → depth+1</span>"| FR
    FW -.->|"<span style='font-size:11px;color:#c2410c'>ack · set next_allowed_at</span>"| HOST
    REAP -.->|"<span style='font-size:11px;color:#c2410c'>no detector needed</span>"| FR
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class SEED,FR,HOST,FW,BLOB,PAR,DUP,REAP n;
    linkStyle 0,1,2,3,4,5,6 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 7,8 stroke:#c2410c,stroke-width:1.6px;
