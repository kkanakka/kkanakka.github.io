%% section: Design
%% caption: Architecture — stateless model, stateful product
flowchart TB
    CL["<b>Client</b><br/>SSE, Last-Event-ID<br/>idempotency key per send"]
    GW["<b>Gateway</b><br/>JWT + token quota<br/>holds the SSE socket"]
    CS["<b>Chat service</b><br/>persist user msg (+ tokenCount)<br/>context builder: budget = window − reply<br/>output safety + resume buffer"]
    HOT[("<b>Redis</b> — hot tail<br/>last N msgs per active conv<br/>usage:{user}:{window} counters")]
    CONV[("<b>Conversation store</b> (wide-column)<br/>PK conversationId, CK createdAt<br/>message {role, content, tokens}<br/>GSI userId → updatedAt (sidebar)<br/>row: rollingSummary, title")]
    MEM[("<b>Memory store</b><br/>per-user distilled facts<br/>user-visible and editable")]
    IG["<b>Inference gateway</b><br/>batch · route by prefix hash<br/>continuous batching"]
    GPU["<b>GPU replicas</b><br/>KV cache in HBM<br/>shared system prompt warm"]
    K["<b>Kafka</b><br/>message.created<br/>usage.event"]
    WK["<b>Async workers</b> (small-model pool)<br/>title on turn 1<br/>rolling summary every K turns<br/>memory extraction · metering"]

    CL -->|"1 POST message (SSE)"| GW
    GW -->|"2 forward + idem key"| CS
    CS -->|"3 append user msg"| CONV
    CS -->|"4 read summary + last N + memory"| HOT
    HOT -.-> CONV
    CS --> MEM
    CS -->|"5 full prompt, every turn"| IG
    IG -->|"6 prefix-affinity route"| GPU
    GPU -->|"7 token stream"| CS
    CS -->|"8 SSE deltas (8-token lookahead)"| CL
    CS -->|"9 append assistant msg + usage"| CONV
    CS -.->|"10 events (async)"| K
    K -.-> WK
    WK -.->|"summary · memory · title"| CONV
    WK -.->|"counters the gateway reads next turn"| HOT
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px,color:#111111;
    class CL,GW,CS,HOT,CONV,MEM,IG,GPU,K,WK n;
    linkStyle 0,1,2,3,5,6,7,8,9,10 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 4,11,12,13,14 stroke:#7a2f6d,stroke-width:1.6px;
