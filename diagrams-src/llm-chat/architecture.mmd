%% section: Design
%% caption: Architecture — stateless model, stateful product
flowchart LR
    CL("<b>Client</b><br/><span style='font-size:12px;color:#555'>SSE · Last-Event-ID<br/>idempotency key per send</span>")
    GW("<b>Gateway</b><br/><span style='font-size:12px;color:#555'>JWT + token quota<br/>holds the SSE socket</span>")
    CS("<b>Chat Service</b><br/><span style='font-size:12px;color:#555'>persist msg + tokenCount<br/>context = window − reply<br/>output safety + resume buffer</span>")
    IG("<b>Inference GW → GPUs</b><br/><span style='font-size:12px;color:#555'>route by prefix hash<br/>continuous batching<br/>KV cache in HBM</span>")
    RD("<b>Redis</b><br/><span style='font-family:Menlo,monospace;font-size:11.5px;color:#333'>hot tail: last N msgs<br/>usage:{user}:{window}</span>")
    CV("<b>Conversation store</b> (wide-column)<br/><span style='font-family:Menlo,monospace;font-size:11.5px;color:#333'>PK conversationId, CK ts<br/>msg {role, content, tokens}<br/>GSI userId → updatedAt<br/>row: rollingSummary, title</span>")
    ME("<b>Memory store</b><br/><span style='font-family:Menlo,monospace;font-size:11.5px;color:#333'>per-user facts<br/>user-visible, editable</span>")
    WK("<b>Kafka → workers</b><br/><span style='font-size:12px;color:#555'>title · rolling summary<br/>memory extraction · metering<br/>small-model pool</span>")

    CL -->|"1 POST (SSE)"| GW
    GW -->|"2 forward + idem key"| CS
    CS -->|"3 append msg"| CV
    CS -->|"4 summary + last N + memory"| RD
    CS -->|"5 full prompt, every turn"| IG
    IG -->|"6 token stream"| CS
    CS -->|"7 SSE deltas (8-token lookahead)"| CL
    CS -.->|"8 events"| WK
    WK -.->|"summary · memory · title"| CV
    WK -.->|"counters"| RD
    CS -.-> ME
%% --- style (generated by scripts/style-flowcharts.js) ---
    classDef n fill:#ffffff,stroke:#111111,stroke-width:1.6px;
    class CL,GW,CS,IG,RD,CV,ME,WK n;
    linkStyle 0,1,2,3,4,5,6 stroke:#2f4fd0,stroke-width:1.6px;
    linkStyle 7,8,9,10 stroke:#c2410c,stroke-width:1.6px;
